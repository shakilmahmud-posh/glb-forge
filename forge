HARVEST_GATES = {
    # Sourced organic assets carry photographic textures and cannot meet the
    # procedural lane's byte budget — the existing catalogue is 4–39 KB because
    # those assets are untextured boxes and lathes. Measured on the first real
    # harvest: a rose at 12k tris with 512px maps is 830 KB. 1.5 MB leaves head-
    # room for a denser piece without letting a 4 MB one through unnoticed.
    "maxBytes": 1_500_000,
    "maxTris": 40_000,
}


def cmd_harvest(args):
    """Turn a sourced .blend into a staged two-LOD asset `forge import` accepts.

    The judgment stays human — someone searches, picks, deletes the parts they
    do not want, saves. This runs everything after that and stages the result
    in exactly the shape the build lane produces, so `forge import` needs no
    special case for harvested assets.
    """
    import hashlib
    import subprocess
    from datetime import datetime, timezone

    o = {"budget": "12000", "min-ratio": "0.20", "category": "props", "placement": "floor",
         "keep": "", "drop": "", "label": None, "source": None, "slug": None,
         "license": "unknown", "source-url": "", "author": ""}
    i = 0
    while i < len(args):
        key = args[i][2:] if args[i].startswith("--") else None
        if key in o and i + 1 < len(args):
            o[key], i = args[i + 1], i + 2
        else:
            print("usage: forge harvest --source <blend> --slug <slug> --label <label> "
                  "[--category props] [--budget 12000] [--min-ratio 0.20] "
                  "[--keep a,b] [--drop c] "
                  "[--license cc_zero] [--source-url URL] [--author NAME]", file=sys.stderr)
            return 2
    if not o["source"] or not o["slug"] or not o["label"]:
        print("forge harvest: --source, --slug and --label are all required", file=sys.stderr)
        return 2

    slug = o["slug"]
    src = Path(o["source"]).expanduser().resolve()
    if not src.is_file():
        print(f"forge: {src} not found", file=sys.stderr)
        return 2

    staged = REPO / "staging" / slug
    staged.mkdir(parents=True, exist_ok=True)
    blender = find_blender()
    if not blender:
        print("forge: blender not found — run `forge doctor`", file=sys.stderr)
        return 3

    cmd = [blender, "--background", "--factory-startup", "--python-exit-code", "3",
           "-P", str(REPO / "builder" / "harvest.py"), "--",
           "--source", str(src), "--slug", slug, "--out-dir", str(staged),
           "--budget", o["budget"], "--min-ratio", o["min-ratio"]]
    if o["keep"]:
        cmd += ["--keep", o["keep"]]
    if o["drop"]:
        cmd += ["--drop", o["drop"]]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr[-2000:])
        print(f"forge: {slug}: harvest failed (exit {proc.returncode})", file=sys.stderr)
        return 1

    hj = staged / "harvest.json"
    if not hj.is_file():
        print(f"forge: {slug}: harvest produced no report", file=sys.stderr)
        return 1
    h = json.loads(hj.read_text())

    # `forge import` reads thumb.png; harvest names it after the slug.
    (staged / "thumb.png").write_bytes((staged / f"{slug}.png").read_bytes())

    dims, tris = h["dims"], h["decimate"]["after"]
    lo_bytes = h["bytes"]["lo"]
    gates = {
        "budget": "pass" if tris <= HARVEST_GATES["maxTris"] else "fail",
        "fileSize": "pass" if lo_bytes <= HARVEST_GATES["maxBytes"] else "fail",
        "geometry": "pass" if tris > 0 else "fail",
        # The decimator floors rather than failing, and collapse near the floor
        # shreds thin geometry. harvest.py already refuses; this records it.
        "decimateFloor": "fail" if h["decimate"].get("floored") else "pass",
        # A collapse far below the base cage flattens curved detail into facets
        # while every count-based gate still reads pass — this is what shipped a
        # ruined rose at 10.6% of its cage. harvest.py refuses; this records it.
        "collapseRatio": "fail" if h["decimate"].get("tooAggressive") else "pass",
        "footprint": "pass" if 0.02 <= max(dims.values()) <= 30 else "fail",
    }
    failures = [k for k, v in gates.items() if v != "pass"]

    # Not a spec sha — there is no spec. Hashing the source plus the knobs
    # keeps the ledger honest: re-harvesting the same file the same way is
    # the same asset, and changing the budget is not.
    digest = hashlib.sha256(
        src.read_bytes() + f"|{o['budget']}|{o['keep']}|{o['drop']}".encode()
    ).hexdigest()

    (staged / "report.json").write_text(json.dumps({
        "slug": slug, "pass": not failures, "triCount": tris,
        "budget": int(o["budget"]),
        "boundsM": [dims["widthM"], dims["depthM"], dims["heightM"]],
        "baseY": 0.0, "materialCount": 1, "fileBytes": lo_bytes,
        "gates": gates, "failures": failures,
        "forgeVersion": FORGE_VERSION if "FORGE_VERSION" in globals() else "0.1.0",
        "specSha256": digest,
        "builtAt": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "harvested": True,
    }, indent=2) + "\n")

    footprint = round(max(dims["widthM"], dims["depthM"]), 3)
    (REPO / "harvested").mkdir(exist_ok=True)
    (REPO / "harvested" / f"{slug}.json").write_text(json.dumps({
        "slug": slug, "label": o["label"],
        # Shown as the poly-tier chip in the review UI. Not "low"/"high" --
        # those are Forge budget tiers and this asset was not built to one.
        "detail": "sourced",
        "harvested": {
            "source": str(src), "license": o["license"],
            "sourceUrl": o["source-url"], "author": o["author"],
            "originalTris": h["decimate"]["before"], "shippedTris": tris,
        },
        # `_first_color` reads spec["materials"]; giving it one keeps the
        # import lane identical for harvested and built assets.
        "materials": {"main": {"color": h.get("dominantColor", "#c8c0b4")}},
        "consumerHints": {"eventos": {
            "kind": "decor", "category": o["category"],
            "footprintM": footprint, "heightM": round(dims["heightM"], 3),
            "defaultHeightM": 0.0, "placement": o["placement"],
        }},
    }, indent=2) + "\n")

    verdict = "PASS" if not failures else "FAIL: " + ", ".join(failures)
    print(f"forge: {slug} harvested — {h['decimate']['before']:,} → {tris:,} tris, "
          f"{lo_bytes/1024:.0f} KB web / {h['bytes']['hi']/1048576:.1f} MB render, "
          f"{dims['widthM']:.2f} × {dims['depthM']:.2f} × {dims['heightM']:.2f} m  [{verdict}]")
    if failures:
        return 1
    print(f"forge: next → forge import --consumer eventos --slugs {slug}")
    return 0


def cmd_import(args):
    from datetime import datetime, timezone

    consumer = slugs = None
    authored = "unattributed"
    i = 0
    while i < len(args):
        if args[i] == "--consumer" and i + 1 < len(args):
            consumer, i = args[i + 1], i + 2
        elif args[i] == "--slugs" and i + 1 < len(args):
            slugs, i = [s for s in args[i + 1].split(",") if s], i + 2
        elif args[i] == "--authored-by" and i + 1 < len(args):
            authored, i = args[i + 1], i + 2
        else:
            print("usage: forge import --consumer <name> --slugs a,b [--authored-by <model>]",
                  file=sys.stderr)
            return 2
    if not consumer or not slugs:
        print("usage: forge import --consumer <name> --slugs a,b [--authored-by <model>]",
              file=sys.stderr)
        return 2

    consumers_path = Path(os.environ.get("FORGE_CONSUMERS", REPO / "consumers.json"))
    library_path = Path(os.environ.get("FORGE_LIBRARY", REPO / "library.json"))
    consumers = json.loads(consumers_path.read_text())
    if consumer not in consumers:
        print(f"forge: unknown consumer '{consumer}' (see {consumers_path})", file=sys.stderr)
        return 2
    cfg = consumers[consumer]
    root = Path(cfg["root"])
    library = json.loads(library_path.read_text())

    worst = 0
    for slug in slugs:
        staged = REPO / "staging" / slug
        if not (staged / "report.json").is_file():
            print(f"forge: {slug}: not staged — `forge build {slug}` first", file=sys.stderr)
            worst = max(worst, 2)
            continue
        report = json.loads((staged / "report.json").read_text())
        if not report.get("pass"):
            print(f"forge: {slug}: gates failing — fix the spec before import", file=sys.stderr)
            worst = max(worst, 1)
            continue
        spec = _find_spec(slug)
        hints = ((spec or {}).get("consumerHints") or {}).get(consumer)
        if not hints:
            print(f"forge: {slug}: spec missing consumerHints.{consumer}", file=sys.stderr)
            worst = max(worst, 2)
            continue
        glb_src = staged / f"{slug}.glb"
        files = []

        if hints["kind"] == "decor":
            catalog_p = root / cfg["decor"]["catalogJson"]
            if not catalog_p.is_file():
                print(f"forge: {slug}: {catalog_p} missing — run eventos integration §A first",
                      file=sys.stderr)
                worst = max(worst, 3)
                continue
            catalog = json.loads(catalog_p.read_text())
            if any(e.get("slug") == slug for e in catalog):
                print(f"forge: {slug}: already in {catalog_p.name} — remove it first to re-import",
                      file=sys.stderr)
                worst = max(worst, 2)
                continue
            glb_dest = root / cfg["decor"]["glbDir"] / f"{slug}.glb"
            thumb_dest = root / cfg["decor"]["thumbDir"] / f"{slug}.png"
            glb_dest.parent.mkdir(parents=True, exist_ok=True)
            thumb_dest.parent.mkdir(parents=True, exist_ok=True)
            glb_dest.write_bytes(glb_src.read_bytes())
            thumb_dest.write_bytes((staged / "thumb.png").read_bytes())
            # Two-LOD assets ship a render-quality sibling. Optional on
            # purpose: every Forge-built asset predates this and has none.
            hi_src = staged / f"{slug}.hi.glb"
            if hi_src.is_file():
                hi_dest = root / cfg["decor"]["glbDir"] / f"{slug}.hi.glb"
                hi_dest.write_bytes(hi_src.read_bytes())
            catalog.append({
                "slug": slug,
                "label": spec["label"],
                "category": hints.get("category", "props"),
                "footprintM": hints["footprintM"],
                "defaultHeightM": hints.get("defaultHeightM", 0),
                "heightM": hints["heightM"],
                "fallbackShape": _fallback_shape(spec),
                "fallbackColor": _first_color(spec),
                "placement": hints.get("placement", "floor"),
            })
            catalog_p.write_text(json.dumps(catalog, indent=2) + "\n")
            files = [str(glb_dest), str(thumb_dest), str(catalog_p)]
            if hi_src.is_file():
                files.append(str(hi_dest))
            print(f"forge: {slug} → décor lane: GLB + thumb copied, catalog entry appended")

        else:  # component lane: copy GLB, emit checklist, STOP — never edit TS
            glb_dest = root / cfg["component"]["glbDir"] / f"{slug}.glb"
            if glb_dest.exists():
                print(f"forge: {slug}: {glb_dest} already exists — remove it to re-import",
                      file=sys.stderr)
                worst = max(worst, 2)
                continue
            glb_dest.parent.mkdir(parents=True, exist_ok=True)
            glb_dest.write_bytes(glb_src.read_bytes())
            ps = spec.get("pictureSurface")
            snippet = json.dumps({
                "componentType": hints["componentType"],
                "label": spec["label"],
                "footprintM": hints["footprintM"],
                "heightM": hints["heightM"],
                "assetSlug": slug,
                "pictureSurface": ps,
            }, indent=2)
            checklist = COMPONENT_CHECKLIST.format(
                slug=slug, glb_dest=glb_dest, component_type=hints["componentType"],
                footprint=hints["footprintM"], height=hints["heightM"], label=spec["label"],
                picture_surface=(f"face \"{ps['face']}\" of part \"{ps['part']}\"" if ps else "none"),
                snippet=snippet)
            (staged / "import-checklist.md").write_text(checklist)
            files = [str(glb_dest)]
            print(f"forge: {slug} → component lane: GLB copied; dev checklist at "
                  f"{staged / 'import-checklist.md'} (TS edits are a dev task — stopping here)")

        credits = root / cfg.get("credits", "")
        if cfg.get("credits") and credits.is_file():
            hv = spec.get("harvested")
            with credits.open("a") as fh:
                if hv:
                    # A harvested asset is somebody else's work. Recording it
                    # as a "Forge original" would make this file a fiction,
                    # and this file is the only provenance record there is.
                    who = hv.get("author") or "unknown author"
                    fh.write(f"- Harvested: `{slug}` — {who}, licence "
                             f"{hv.get('license', 'unknown')}"
                             f"{', ' + hv['sourceUrl'] if hv.get('sourceUrl') else ''}"
                             f" (imported {datetime.now(timezone.utc).date()})\n")
                else:
                    fh.write(f"- Blender Forge original: `{slug}` (spec sha "
                             f"{report['specSha256'][:8]}, imported "
                             f"{datetime.now(timezone.utc).date()})\n")
            files.append(str(credits))

        library["assets"].append({
            "slug": slug,
            "specSha256": report["specSha256"],
            "consumer": consumer,
            "kind": hints["kind"],
            "files": files,
            "importedAt": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "authoredBy": authored,
        })
        library_path.write_text(json.dumps(library, indent=2) + "\n")

    return worst


REVIEW_DECISIONS = ("approved", "changes", "rejected", "pending")
REVIEW_MIME = {".html": "text/html; charset=utf-8", ".js": "text/javascript",
               ".json": "application/json", ".css": "text/css", ".png": "image/png",
               ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".webp": "image/webp",
               ".glb": "model/gltf-binary",
               ".wasm": "application/wasm"}


def _staged_assets():
    """Everything `forge review` needs per staged asset, JSON-ready."""
    staging = REPO / "staging"
    if not staging.is_dir():
        return []
    try:
        lib = json.loads((REPO / "library.json").read_text()).get("assets", [])
    except (OSError, json.JSONDecodeError):
        lib = []
    out = []
    for d in sorted(staging.iterdir()):
        rep_p = d / "report.json"
        if not d.is_dir() or not rep_p.is_file():
            continue
        try:
            rep = json.loads(rep_p.read_text())
        except json.JSONDecodeError:
            continue
        slug = rep.get("slug", d.name)
        spec = _find_spec(slug) or {}
        decision = None
        if (d / "decision.json").is_file():
            try:
                decision = json.loads((d / "decision.json").read_text())
            except json.JSONDecodeError:
                pass
        out.append({
            "slug": slug,
            "label": spec.get("label", slug),
            "detail": spec.get("detail"),
            "hints": (spec.get("consumerHints") or {}).get("eventos") or {},
            "report": rep,
            "decision": decision,
            "referenceImages": spec.get("referenceImages") or [],
            "shipped": sorted({a["consumer"] for a in lib if a.get("slug") == slug}),
            "hasGlb": (d / f"{slug}.glb").is_file(),
            "thumb": (d / "thumb.png").is_file(),
        })
    return out


def cmd_review(args):
    """Serve the interactive review UI on localhost. Decisions are written to
    staging/<slug>/decision.json — import stays a separate, deliberate step."""
    import webbrowser
    from datetime import datetime, timezone
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import unquote

    port, open_browser = 8137, True
    i = 0
    while i < len(args):
        if args[i] == "--port" and i + 1 < len(args):
            try:
                port = int(args[i + 1])
            except ValueError:
                print("forge: --port takes a number", file=sys.stderr)
                return 2
            i += 2
        elif args[i] == "--no-open":
            open_browser, i = False, i + 1
        else:
            print("usage: forge review [--port N] [--no-open]", file=sys.stderr)
            return 2

    index = REPO / "review" / "index.html"
    if not index.is_file():
        print("forge: review/index.html missing — repo incomplete", file=sys.stderr)
        return 3

    def safe_file(base, rel):
        p = (base / rel).resolve()
        try:
            p.relative_to(base.resolve())
        except ValueError:
            return None
        return p if p.is_file() else None

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_):  # keep the terminal quiet
            pass

        def _send(self, code, body, ctype="application/json"):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            path = self.path.split("?", 1)[0]
            if path in ("/", "/index.html"):
                return self._send(200, index.read_bytes(), REVIEW_MIME[".html"])
            if path == "/api/staged":
                return self._send(200, _staged_assets())
            for prefix, base in (("/vendor/", REPO / "review" / "vendor"),
                                 ("/staging/", REPO / "staging"),
                                 ("/specs/references/", REPO / "specs" / "references")):
                if path.startswith(prefix):
                    f = safe_file(base, unquote(path[len(prefix):]))
                    if f:
                        return self._send(200, f.read_bytes(),
                                          REVIEW_MIME.get(f.suffix.lower(),
                                                          "application/octet-stream"))
                    return self._send(404, {"error": "not found"})
            return self._send(404, {"error": "not found"})

        def do_POST(self):
            if self.path.split("?", 1)[0] != "/api/decision":
                return self._send(404, {"error": "not found"})
            try:
                body = json.loads(self.rfile.read(
                    int(self.headers.get("Content-Length", 0))) or b"{}")
            except (ValueError, json.JSONDecodeError):
                return self._send(400, {"error": "bad JSON body"})
            slug = body.get("slug", "")
            decision = body.get("decision")
            note = (body.get("note") or "").strip()
            if not SLUG_RE.match(slug) or not (REPO / "staging" / slug / "report.json").is_file():
                return self._send(400, {"error": f"'{slug}' is not a staged asset"})
            if decision not in REVIEW_DECISIONS:
                return self._send(400, {"error": f"decision must be one of {list(REVIEW_DECISIONS)}"})
            if decision == "changes" and not note:
                return self._send(400, {"error": "a change request needs a note"})
            if len(note) > 4000:
                return self._send(400, {"error": "note too long (4000 chars max)"})
            dec_p = REPO / "staging" / slug / "decision.json"
            if decision == "pending":
                dec_p.unlink(missing_ok=True)
                return self._send(200, {"slug": slug, "decision": None})
            record = {"slug": slug, "decision": decision, "note": note,
                      "decidedAt": datetime.now(timezone.utc).isoformat(timespec="seconds")}
            dec_p.write_text(json.dumps(record, indent=2) + "\n")
            return self._send(200, record)

    try:
        srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError as e:
        print(f"forge: cannot bind 127.0.0.1:{port} ({e.strerror}) — try --port", file=sys.stderr)
        return 3
    url = f"http://127.0.0.1:{port}/"
    print(f"forge: review UI → {url}  (Ctrl-C to stop)\n"
          f"forge: decisions land in staging/<slug>/decision.json; ship approved slugs with\n"
          f"forge:   ./forge import --consumer eventos --slugs <a,b> --authored-by <model>")
    if open_browser:
        webbrowser.open(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nforge: review server stopped")
    finally:
        srv.server_close()
    return 0


def _stub(phase, what):
    print(f"forge: {what} is not implemented yet — arrives in {phase} "
          f"(see ~/dev/.claude/plans/grill-blender-forge.md)", file=sys.stderr)
    return 3


def main(argv):
    if len(argv) < 1 or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "doctor":
        return cmd_doctor(args)
    if cmd == "validate":
        return cmd_validate(args)
    if cmd == "build":
        return cmd_build(args)
    if cmd == "sheet":
        return cmd_sheet(args)
    if cmd == "from-image":
        return cmd_from_image(args)
    if cmd == "harvest":
        return cmd_harvest(args)
    if cmd == "import":
        return cmd_import(args)
    if cmd == "review":
        return cmd_review(args)
    print(f"forge: unknown command '{cmd}' (try: forge help)", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
