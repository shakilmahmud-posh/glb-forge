#!/usr/bin/env python3
"""forge — Blender Forge CLI. Python 3 stdlib only (no pip deps).

Subcommands:
  doctor      environment check (Blender pin, layout, staging writable)
  validate    validate spec file(s) against forgeSpec v1 → machine-readable failures[]
  build       build spec → staging/<slug>/{glb,thumb,report}      (P1)
  sheet       render staging/contact-sheet.html                   (P3)
  from-image  scaffold an image-driven spec                       (P3)
  harvest     sourced .blend → staged two-LOD decor asset         (P6)
  import      ship approved slugs to a consumer + ledger          (P4)
  review      interactive review UI (3D viewer + approve/reject)  (P5+)

Exit codes: 0 ok · 1 gate fail · 2 schema error · 3 environment error.
Plan of record: ~/dev/.claude/plans/grill-blender-forge.md
"""

import hashlib
import json
import math
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

FORGE_VERSION = "0.1.0"
BLENDER_PIN = "5.1.1"
BLENDER_APP = "/Applications/Blender.app/Contents/MacOS/Blender"
REPO = Path(__file__).resolve().parent

SLUG_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
COMPONENT_TYPE_RE = re.compile(r"^[a-z][a-z0-9_]*$")
HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")

PART_TYPES = ("box", "cylinder", "plane", "lathe", "drape", "array")
FACES = ("front", "back", "left", "right", "top")
DETAILS = ("low", "mid", "high")
PLACEMENTS = ("floor", "ceiling", "wall")
BUDGETS = {"low": {"tris": 3000, "bytes": 1_500_000}, "mid": {"tris": 15000, "bytes": 4_000_000},
           "high": {"tris": 60000, "bytes": 10_000_000}}
BUILD_TIMEOUT_S = 180

TOP_FIELDS = {"forgeSpec", "slug", "label", "detail", "referenceImages",
              "consumerHints", "materials", "parts", "pictureSurface", "members"}
MEMBER_FIELDS = {"spec", "as", "position", "rotationYDeg"}
MAX_SET_MEMBERS = 24
MAX_SET_MATERIALS = 12  # after cross-member dedupe (gates.py enforces the same cap)
MATERIAL_FIELDS = {"color", "roughness", "metalness", "emissive", "doubleSided"}
EVENTOS_FIELDS = {"kind", "componentType", "category", "footprintM", "heightM",
                  "defaultHeightM", "placement"}
TYPE_FIELDS = {
    "box": {"size", "bevelM"},
    "cylinder": {"radiusTop", "radiusBottom", "heightM", "segments"},
    "plane": {"size"},
    "lathe": {"profile", "segments"},
    "drape": {"from", "to", "sagM", "widthM", "segmentsAlong", "segmentsAcross",
              "gatherEnds", "wrinkle"},
    "array": {"of", "mode", "count", "spacing", "radiusM", "startDeg", "endDeg"},
}


# ---------------------------------------------------------------- helpers

def _num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)


def _int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def _vec(v, n):
    return isinstance(v, list) and len(v) == n and all(_num(x) for x in v)


def _str(v):
    return isinstance(v, str) and v.strip() != ""


# ---------------------------------------------------------------- validator

class Failures:
    def __init__(self):
        self.items = []

    def add(self, path, code, message):
        self.items.append({"path": path, "code": code, "message": message})


def _validate_material(name, mat, f):
    p = f"materials.{name}"
    if not NAME_RE.match(name):
        f.add(p, "invalid_format", "material keys are kebab-case")
    if not isinstance(mat, dict):
        f.add(p, "wrong_type", "material must be an object")
        return
    for k in mat:
        if k not in MATERIAL_FIELDS:
            f.add(f"{p}.{k}", "unknown_field", f"unknown material field '{k}'")
    color = mat.get("color")
    if color is None:
        f.add(f"{p}.color", "missing_field", "material requires color (#rrggbb)")
    elif not (isinstance(color, str) and HEX_RE.match(color)):
        f.add(f"{p}.color", "invalid_format", "color must be #rrggbb (6 hex digits)")
    for k in ("roughness", "metalness"):
        if k in mat and not (_num(mat[k]) and 0 <= mat[k] <= 1):
            f.add(f"{p}.{k}", "out_of_range", f"{k} must be a number in [0,1]")
    if "emissive" in mat and not (isinstance(mat["emissive"], str) and HEX_RE.match(mat["emissive"])):
        f.add(f"{p}.emissive", "invalid_format", "emissive must be #rrggbb")
    if "doubleSided" in mat and not isinstance(mat["doubleSided"], bool):
        f.add(f"{p}.doubleSided", "wrong_type", "doubleSided must be boolean")


def _validate_part(part, path, materials, f, inline=False):
    """Validate one part; returns (name, type, fabric_materials_used)."""
    if not isinstance(part, dict):
        f.add(path, "wrong_type", "part must be an object")
        return None, None, []
    ptype = part.get("type")
    if ptype not in PART_TYPES:
        f.add(f"{path}.type", "invalid_enum", f"type must be one of {list(PART_TYPES)}")
        return part.get("name"), None, []

    allowed = {"name", "type", "position", "rotationDeg"} | TYPE_FIELDS[ptype]
    if ptype != "array":
        allowed.add("material")
    for k in part:
        if k not in allowed:
            f.add(f"{path}.{k}", "unknown_field", f"unknown field '{k}' for type {ptype}")

    name = part.get("name")
    if not inline:
        if not _str(name):
            f.add(f"{path}.name", "missing_field", "part requires a name")
        elif not NAME_RE.match(name):
            f.add(f"{path}.name", "invalid_format", "part names are kebab-case")

    if not inline and "position" not in part:
        f.add(f"{path}.position", "missing_field", "part requires position [x,y,z] (metres)")
    if "position" in part and not _vec(part["position"], 3):
        f.add(f"{path}.position", "wrong_type", "position must be [x,y,z] numbers")
    if "rotationDeg" in part and not _vec(part["rotationDeg"], 3):
        f.add(f"{path}.rotationDeg", "wrong_type", "rotationDeg must be [x,y,z] degrees")

    fabric_mats = []
    if ptype != "array":
        mat = part.get("material")
        if not _str(mat):
            f.add(f"{path}.material", "missing_field", "part requires a material reference")
        elif mat not in materials:
            f.add(f"{path}.material", "unknown_material",
                  f"material '{mat}' not declared in materials")
        elif ptype in ("plane", "drape"):
            fabric_mats.append((mat, path))

    def req(field, ok, msg):
        if field not in part:
            f.add(f"{path}.{field}", "missing_field", msg)
        elif not ok(part[field]):
            f.add(f"{path}.{field}", "out_of_range", msg)

    if ptype == "box":
        req("size", lambda v: _vec(v, 3) and all(x > 0 for x in v),
            "box requires size [x,y,z], all > 0")
        if "bevelM" in part and not (_num(part["bevelM"]) and part["bevelM"] >= 0):
            f.add(f"{path}.bevelM", "out_of_range", "bevelM must be ≥ 0")

    elif ptype == "cylinder":
        req("radiusTop", lambda v: _num(v) and v >= 0, "cylinder requires radiusTop ≥ 0")
        req("radiusBottom", lambda v: _num(v) and v >= 0, "cylinder requires radiusBottom ≥ 0")
        req("heightM", lambda v: _num(v) and v > 0, "cylinder requires heightM > 0")
        if _num(part.get("radiusTop")) and _num(part.get("radiusBottom")) \
                and part["radiusTop"] == 0 and part["radiusBottom"] == 0:
            f.add(path, "degenerate_geometry", "radiusTop and radiusBottom cannot both be 0")
        if "segments" in part and not (_int(part["segments"]) and 3 <= part["segments"] <= 64):
            f.add(f"{path}.segments", "out_of_range", "segments must be int 3..64")

    elif ptype == "plane":
        req("size", lambda v: _vec(v, 2) and all(x > 0 for x in v),
            "plane requires size [w,h], both > 0")

    elif ptype == "lathe":
        prof = part.get("profile")
        if prof is None:
            f.add(f"{path}.profile", "missing_field", "lathe requires profile [[r,y],…] (≥ 2 points)")
        elif not (isinstance(prof, list) and len(prof) >= 2
                  and all(_vec(pt, 2) and pt[0] >= 0 for pt in prof)):
            f.add(f"{path}.profile", "invalid_format",
                  "profile must be ≥ 2 [r,y] pairs with r ≥ 0")
        if "segments" in part and not (_int(part["segments"]) and 3 <= part["segments"] <= 64):
            f.add(f"{path}.segments", "out_of_range", "segments must be int 3..64")

    elif ptype == "drape":
        req("from", lambda v: _vec(v, 3), "drape requires from [x,y,z]")
        req("to", lambda v: _vec(v, 3), "drape requires to [x,y,z]")
        req("sagM", lambda v: _num(v) and v > 0, "drape requires sagM > 0")
        req("widthM", lambda v: _num(v) and v > 0, "drape requires widthM > 0")
        if "segmentsAlong" in part and not (_int(part["segmentsAlong"]) and 2 <= part["segmentsAlong"] <= 128):
            f.add(f"{path}.segmentsAlong", "out_of_range", "segmentsAlong must be int 2..128")
        if "segmentsAcross" in part and not (_int(part["segmentsAcross"]) and 1 <= part["segmentsAcross"] <= 32):
            f.add(f"{path}.segmentsAcross", "out_of_range", "segmentsAcross must be int 1..32")
        if "gatherEnds" in part and not isinstance(part["gatherEnds"], bool):
            f.add(f"{path}.gatherEnds", "wrong_type", "gatherEnds must be boolean")
        if "wrinkle" in part:
            w = part["wrinkle"]
            if not isinstance(w, dict):
                f.add(f"{path}.wrinkle", "wrong_type", "wrinkle must be {amplitudeM, seed}")
            else:
                for k in w:
                    if k not in ("amplitudeM", "seed"):
                        f.add(f"{path}.wrinkle.{k}", "unknown_field", f"unknown wrinkle field '{k}'")
                if not (_num(w.get("amplitudeM")) and w.get("amplitudeM", 0) > 0):
                    f.add(f"{path}.wrinkle.amplitudeM", "missing_field", "wrinkle requires amplitudeM > 0")
                if not _int(w.get("seed")):
                    f.add(f"{path}.wrinkle.seed", "missing_field",
                          "wrinkle requires an explicit integer seed (determinism)")

    elif ptype == "array":
        of = part.get("of")
        if of is None:
            f.add(f"{path}.of", "missing_field", "array requires an inline part in 'of'")
        else:
            _, of_type, of_fabric = _validate_part(of, f"{path}.of", materials, f, inline=True)
            fabric_mats.extend(of_fabric)
            if of_type == "array":
                f.add(f"{path}.of", "nested_array", "arrays cannot nest in v1")
        mode = part.get("mode")
        if mode not in ("linear", "radial"):
            f.add(f"{path}.mode", "invalid_enum", "array mode must be 'linear' or 'radial'")
        if not (_int(part.get("count")) and 2 <= part.get("count", 0) <= 256):
            f.add(f"{path}.count", "out_of_range", "array count must be int 2..256")
        if mode == "linear":
            if not _vec(part.get("spacing"), 3):
                f.add(f"{path}.spacing", "missing_field", "linear array requires spacing [x,y,z]")
            for k in ("radiusM", "startDeg", "endDeg"):
                if k in part:
                    f.add(f"{path}.{k}", "unexpected_field", f"'{k}' is radial-only")
        elif mode == "radial":
            if not (_num(part.get("radiusM")) and part.get("radiusM", 0) > 0):
                f.add(f"{path}.radiusM", "missing_field", "radial array requires radiusM > 0")
            for k in ("startDeg", "endDeg"):
                if not _num(part.get(k)):
                    f.add(f"{path}.{k}", "missing_field", f"radial array requires {k} (degrees)")
            if "spacing" in part:
                f.add(f"{path}.spacing", "unexpected_field", "'spacing' is linear-only")

    return name, ptype, fabric_mats


# ------------------------------------------------------------ set composition
#
# A "set" spec composes committed specs into one asset: {members: [{spec, as?,
# position, rotationYDeg?}]} instead of materials/parts. The CLI flattens the set
# into an ordinary spec (namespaced parts, deduped materials, composed transforms)
# BEFORE Blender runs, so the builder stays untouched and determinism holds:
# same set spec + same member specs → byte-identical GLB.
#
# Rotation maths matches Blender's Euler 'XYZ' convention (apply X, then Y, then
# Z about global axes ⇒ M = Rz@Ry@Rx); a member's Y-rotation left-multiplies each
# part's rotation and the result is decomposed back to XYZ degrees.

def _mat_mul(a, b):
    return [[sum(a[i][k] * b[k][j] for k in range(3)) for j in range(3)] for i in range(3)]


def _mat_vec(m, v):
    return [sum(m[i][k] * v[k] for k in range(3)) for i in range(3)]


def _rot_y_mat(deg):
    c, s = math.cos(math.radians(deg)), math.sin(math.radians(deg))
    return [[c, 0.0, s], [0.0, 1.0, 0.0], [-s, 0.0, c]]


def _euler_deg_to_mat(deg3):
    rx, ry, rz = (math.radians(a) for a in deg3)
    cx, sx = math.cos(rx), math.sin(rx)
    cy, sy = math.cos(ry), math.sin(ry)
    cz, sz = math.cos(rz), math.sin(rz)
    rx_m = [[1, 0, 0], [0, cx, -sx], [0, sx, cx]]
    ry_m = [[cy, 0, sy], [0, 1, 0], [-sy, 0, cy]]
    rz_m = [[cz, -sz, 0], [sz, cz, 0], [0, 0, 1]]
    return _mat_mul(rz_m, _mat_mul(ry_m, rx_m))


def _mat_to_euler_deg(m):
    sy = max(-1.0, min(1.0, -m[2][0]))
    cy = math.sqrt(max(0.0, 1.0 - sy * sy))
    if cy > 1e-8:
        rx = math.atan2(m[2][1], m[2][2])
        ry = math.asin(sy)
        rz = math.atan2(m[1][0], m[0][0])
    else:  # gimbal: ry = ±90°, fold everything into rx
        ry = math.copysign(math.pi / 2.0, sy)
        rz = 0.0
        sign = math.copysign(1.0, sy)
        rx = math.atan2(sign * m[0][1], sign * m[0][2])
    return [math.degrees(a) for a in (rx, ry, rz)]


def _material_sig(mdef):
    """Identity for cross-member material dedupe — includes every rendered field."""
    return (mdef["color"].lower(), round(float(mdef.get("roughness", 0.8)), 4),
            round(float(mdef.get("metalness", 0.0)), 4),
            (mdef.get("emissive") or "").lower(), bool(mdef.get("doubleSided", False)))


def flatten_set(spec):
    """Set spec → ordinary buildable spec. Raises ValueError on unresolvable members.
    The flattened dict carries `_set` so gates apply the set material cap."""
    materials, sig_to_name, parts = {}, {}, []
    for m in spec["members"]:
        ref = m["spec"]
        mspec = _find_spec(ref)
        if mspec is None:
            raise ValueError(f"member spec '{ref}' not found in specs/ or examples/")
        inst = m.get("as", ref)
        theta = float(m.get("rotationYDeg", 0.0))
        rot_m = _rot_y_mat(theta)
        t = [float(x) for x in m["position"]]
        mat_map = {}
        for name, mdef in mspec["materials"].items():
            sig = _material_sig(mdef)
            if sig in sig_to_name:
                mat_map[name] = sig_to_name[sig]
            else:
                new_name = f"{inst}-{name}"
                materials[new_name] = mdef
                sig_to_name[sig] = new_name
                mat_map[name] = new_name
        for part in mspec["parts"]:
            p = json.loads(json.dumps(part))  # deep copy, deterministic
            p["name"] = f"{inst}-{p['name']}"
            if p["type"] == "array":
                p["of"]["material"] = mat_map[p["of"]["material"]]
            else:
                p["material"] = mat_map[p["material"]]
            pos = [float(x) for x in p.get("position", [0.0, 0.0, 0.0])]
            world = _mat_vec(rot_m, pos)
            p["position"] = [round(world[j] + t[j], 6) + 0.0 for j in range(3)]
            if theta:
                composed = _mat_mul(rot_m, _euler_deg_to_mat(p.get("rotationDeg", [0, 0, 0])))
                p["rotationDeg"] = [round(a, 4) + 0.0 for a in _mat_to_euler_deg(composed)]
            parts.append(p)
    flat = {"forgeSpec": 1, "slug": spec["slug"], "label": spec["label"],
            "detail": spec["detail"], "materials": materials, "parts": parts,
            "_set": len(spec["members"])}
    if spec.get("consumerHints"):
        flat["consumerHints"] = spec["consumerHints"]
    return flat


def _validate_hints(spec, f):
    """consumerHints validation — shared by ordinary specs and sets. Returns ev."""
    hints = spec.get("consumerHints")
    ev = None
    if hints is not None:
        if not isinstance(hints, dict):
            f.add("consumerHints", "wrong_type", "consumerHints must be an object")
        elif "eventos" in hints:
            ev = hints["eventos"]
            p = "consumerHints.eventos"
            if not isinstance(ev, dict):
                f.add(p, "wrong_type", "eventos hints must be an object")
                ev = None
            else:
                for k in ev:
                    if k not in EVENTOS_FIELDS:
                        f.add(f"{p}.{k}", "unknown_field", f"unknown eventos hint '{k}'")
                kind = ev.get("kind")
                if kind not in ("decor", "component"):
                    f.add(f"{p}.kind", "invalid_enum", "kind must be 'decor' or 'component'")
                if kind == "component":
                    ct = ev.get("componentType")
                    if not _str(ct):
                        f.add(f"{p}.componentType", "missing_field",
                              "kind=component requires componentType (snake_case)")
                    elif not COMPONENT_TYPE_RE.match(ct):
                        f.add(f"{p}.componentType", "invalid_format", "componentType is snake_case")
                    for k in ("category", "defaultHeightM"):
                        if k in ev:
                            f.add(f"{p}.{k}", "unexpected_field", f"'{k}' is decor-only")
                elif kind == "decor":
                    if not _str(ev.get("category")):
                        f.add(f"{p}.category", "missing_field", "kind=decor requires category")
                    if "componentType" in ev:
                        f.add(f"{p}.componentType", "unexpected_field", "componentType is component-only")
                    if "defaultHeightM" in ev and not (_num(ev["defaultHeightM"]) and ev["defaultHeightM"] >= 0):
                        f.add(f"{p}.defaultHeightM", "out_of_range", "defaultHeightM must be ≥ 0")
                for k in ("footprintM", "heightM"):
                    if not (_num(ev.get(k)) and ev.get(k, 0) > 0):
                        f.add(f"{p}.{k}", "missing_field", f"eventos hints require {k} > 0")
                if "placement" in ev and ev["placement"] not in PLACEMENTS:
                    f.add(f"{p}.placement", "invalid_enum", f"placement must be one of {list(PLACEMENTS)}")
    return ev


def _validate_members(spec, f):
    members = spec.get("members")
    if not (isinstance(members, list) and members):
        f.add("members", "missing_field", "members must be a non-empty array")
        return
    if len(members) > MAX_SET_MEMBERS:
        f.add("members", "too_many_members", f"{len(members)} members — max {MAX_SET_MEMBERS}")
    seen = {}
    for i, m in enumerate(members):
        p = f"members[{i}]"
        if not isinstance(m, dict):
            f.add(p, "wrong_type", "member must be an object")
            continue
        for k in m:
            if k not in MEMBER_FIELDS:
                f.add(f"{p}.{k}", "unknown_field", f"unknown member field '{k}'")
        ref = m.get("spec")
        if not (_str(ref) and SLUG_RE.match(ref)):
            f.add(f"{p}.spec", "missing_field", "member.spec must be a kebab-case slug")
            continue
        mspec = _find_spec(ref)
        if mspec is None:
            f.add(f"{p}.spec", "unknown_member_spec",
                  f"no committed spec named '{ref}' (specs/ or examples/)")
            continue
        if "members" in mspec:
            f.add(f"{p}.spec", "nested_set", f"'{ref}' is itself a set — sets cannot nest (v1)")
            continue
        if validate_spec(mspec):
            f.add(f"{p}.spec", "member_spec_invalid", f"'{ref}' does not validate — fix it first")
        inst = m.get("as", ref)
        if not (_str(inst) and NAME_RE.match(inst)):
            f.add(f"{p}.as", "invalid_format", "member.as must be kebab-case")
        elif inst in seen:
            f.add(f"{p}.as", "duplicate_member_name",
                  f"instance name '{inst}' already used at members[{seen[inst]}] — "
                  f"give repeats a unique 'as'")
        else:
            seen[inst] = i
        if not _vec(m.get("position"), 3):
            f.add(f"{p}.position", "missing_field", "member.position must be [x,y,z] metres")
        if "rotationYDeg" in m and not _num(m["rotationYDeg"]):
            f.add(f"{p}.rotationYDeg", "wrong_type", "rotationYDeg must be a number")
    if not f.items:
        try:
            flat = flatten_set(spec)
        except ValueError as e:
            f.add("members", "flatten_failed", str(e))
            return
        n = len(flat["materials"])
        if n > MAX_SET_MATERIALS:
            f.add("members", "too_many_materials",
                  f"{n} distinct materials after dedupe — max {MAX_SET_MATERIALS} per set")


def validate_spec(spec):
    """Validate a parsed forgeSpec v1 dict. Returns list of failure objects."""
    f = Failures()
    if not isinstance(spec, dict):
        f.add("$", "wrong_type", "spec root must be an object")
        return f.items

    for k in spec:
        if k not in TOP_FIELDS:
            f.add(k, "unknown_field", f"unknown top-level field '{k}'")

    if spec.get("forgeSpec") != 1:
        f.add("forgeSpec", "unsupported_forge_version", "forgeSpec must be 1")
    slug = spec.get("slug")
    if not _str(slug):
        f.add("slug", "missing_field", "slug is required")
    elif not SLUG_RE.match(slug):
        f.add("slug", "invalid_slug", "slug must be kebab-case ([a-z0-9-])")
    if not _str(spec.get("label")):
        f.add("label", "missing_field", "label is required")
    if spec.get("detail") not in DETAILS:
        f.add("detail", "invalid_enum", f"detail must be one of {list(DETAILS)}")

    if "referenceImages" in spec:
        ri = spec["referenceImages"]
        if not (isinstance(ri, list) and all(_str(x) for x in ri)):
            f.add("referenceImages", "wrong_type", "referenceImages must be a list of paths")

    # set spec: members compose other specs — mutually exclusive with own geometry
    if "members" in spec:
        for k in ("parts", "materials", "pictureSurface"):
            if k in spec:
                f.add(k, "set_exclusive",
                      f"a set spec must not declare '{k}' — members compose committed specs")
        _validate_hints(spec, f)
        _validate_members(spec, f)
        return f.items

    # materials
    materials = spec.get("materials")
    if not isinstance(materials, dict) or not materials:
        f.add("materials", "missing_field", "materials object with 1..4 entries is required")
        materials = {}
    elif len(materials) > 4:
        f.add("materials", "too_many_materials", f"{len(materials)} materials — max 4 per asset")
    for mname, mat in materials.items():
        _validate_material(mname, mat, f)

    # consumerHints
    ev = _validate_hints(spec, f)

    # parts
    parts = spec.get("parts")
    names, types_by_name, fabric_mats = {}, {}, []
    if not (isinstance(parts, list) and parts):
        f.add("parts", "missing_field", "parts must be a non-empty array")
    else:
        for i, part in enumerate(parts):
            name, ptype, fabrics = _validate_part(part, f"parts[{i}]", materials, f)
            fabric_mats.extend(fabrics)
            if isinstance(name, str) and name:
                if name in names:
                    f.add(f"parts[{i}].name", "duplicate_part_name",
                          f"part name '{name}' already used at parts[{names[name]}]")
                else:
                    names[name] = i
                    types_by_name[name] = ptype

    # fabric materials must render backfaces
    for mat, path in fabric_mats:
        if isinstance(materials.get(mat), dict) and materials[mat].get("doubleSided") is not True:
            f.add(f"materials.{mat}.doubleSided", "fabric_material_must_be_double_sided",
                  f"material '{mat}' is used by plane/drape at {path} — set doubleSided: true")

    # pictureSurface
    ps = spec.get("pictureSurface")
    if ps is not None:
        if not isinstance(ps, dict):
            f.add("pictureSurface", "wrong_type", "pictureSurface must be {part, face}")
        else:
            for k in ps:
                if k not in ("part", "face"):
                    f.add(f"pictureSurface.{k}", "unknown_field", f"unknown field '{k}'")
            tgt = ps.get("part")
            if not _str(tgt):
                f.add("pictureSurface.part", "missing_field", "pictureSurface requires part")
            elif tgt not in names:
                f.add("pictureSurface.part", "unknown_part", f"no part named '{tgt}'")
            elif types_by_name.get(tgt) != "box":
                f.add("pictureSurface.part", "picture_surface_part_not_box",
                      "pictureSurface must target a box part (Event OS faces = box faces)")
            if ps.get("face") not in FACES:
                f.add("pictureSurface.face", "invalid_enum", f"face must be one of {list(FACES)}")
            if not (isinstance(ev, dict) and ev.get("kind") == "component"):
                f.add("pictureSurface", "picture_surface_requires_component",
                      "pictureSurface only works when consumerHints.eventos.kind=component "
                      "(Event OS looks bind to floor-plan components, not décor)")

    return f.items


