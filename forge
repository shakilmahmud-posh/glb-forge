def find_blender():
    env = os.environ.get("FORGE_BLENDER")  # test/dev override
    if env:
        return env if Path(env).is_file() else None
    if Path(BLENDER_APP).is_file():
        return BLENDER_APP
    return shutil.which("blender")


def cmd_doctor(_args):
    ok = True

    def check(label, passed, detail=""):
        nonlocal ok
        mark = "✓" if passed else "✗"
        print(f"  {mark} {label}" + (f" — {detail}" if detail else ""))
        ok = ok and passed

    print(f"forge {FORGE_VERSION} doctor")
    check("python3 ≥ 3.9", sys.version_info >= (3, 9), sys.version.split()[0])

    blender = find_blender()
    if not blender:
        check("blender binary", False, "not found (install Blender 5.1.1)")
    else:
        try:
            out = subprocess.run([blender, "--version"], capture_output=True,
                                 text=True, timeout=30).stdout.splitlines()
            version = next((ln.split()[1] for ln in out if ln.startswith("Blender ")), "?")
        except Exception as e:  # noqa: BLE001 — doctor reports, never crashes
            version = f"error: {e}"
        check(f"blender pinned {BLENDER_PIN}", version == BLENDER_PIN, f"{blender} → {version}")

    try:
        json.loads((REPO / "schema" / "forge-spec.schema.json").read_text())
        check("schema/forge-spec.schema.json", True, "valid JSON")
    except Exception as e:  # noqa: BLE001
        check("schema/forge-spec.schema.json", False, str(e))

    for rel in ("builder/builder.py", "builder/gates.py", "SPEC_GUIDE.md"):
        check(rel, (REPO / rel).is_file())

    # consumers.json and library.json are per-installation state, not part of
    # the tool. A fresh clone has neither, and `build` does not need them —
    # only `import` reads consumers, only `harvest` writes the library. Failing
    # doctor on their absence tells a new user their install is broken when it
    # is merely empty, so report and carry on.
    for rel, what in (("consumers.json", "import targets — copy consumers.example.json to add one"),
                      ("library.json", "harvested-asset index — written on first harvest")):
        present = (REPO / rel).is_file()
        print(f"  {'✓' if present else '·'} {rel}"
              + ("" if present else f" — absent, {what}"))

    try:
        staging = REPO / "staging"
        staging.mkdir(exist_ok=True)
        probe = staging / ".doctor-probe"
        probe.write_text("ok")
        probe.unlink()
        check("staging/ writable", True)
    except Exception as e:  # noqa: BLE001
        check("staging/ writable", False, str(e))

    npx = shutil.which("npx")
    print(f"  {'✓' if npx else '·'} npx (gltf-transform inspect, P1 acceptance)"
          + ("" if npx else " — optional, not found"))

    print("doctor: OK" if ok else "doctor: FAILED")
    return 0 if ok else 3


def _resolve_spec_paths(args):
    if args and args[0] == "--all":
        return sorted(list((REPO / "specs").glob("*.json"))
                      + list((REPO / "examples").glob("*.json")))
    paths = []
    for a in args:
        p = Path(a)
        if not p.is_file():
            p = REPO / "specs" / f"{a}.json"
        paths.append(p)
    return paths


def cmd_validate(args):
    if not args:
        print("usage: forge validate <spec.json|slug> [...] | --all", file=sys.stderr)
        return 2
    worst = 0
    for path in _resolve_spec_paths(args):
        try:
            spec = json.loads(Path(path).read_text())
            failures = validate_spec(spec)
        except FileNotFoundError:
            print(json.dumps({"file": str(path), "valid": False, "failures": [
                {"path": "$", "code": "file_not_found", "message": str(path)}]}))
            worst = max(worst, 2)
            continue
        except json.JSONDecodeError as e:
            print(json.dumps({"file": str(path), "valid": False, "failures": [
                {"path": "$", "code": "invalid_json", "message": str(e)}]}))
            worst = max(worst, 2)
            continue
        result = {"file": str(path),
                  "slug": spec.get("slug") if isinstance(spec, dict) else None,
                  "valid": not failures, "failures": failures}
        print(json.dumps(result))
        if failures:
            worst = max(worst, 2)
    return worst


def cmd_build(args):
    if not args:
        print("usage: forge build <spec.json|slug> [...]", file=sys.stderr)
        return 2
    blender = find_blender()
    if not blender:
        print("forge: blender not found — run `forge doctor`", file=sys.stderr)
        return 3
    worst = 0
    for path in _resolve_spec_paths(args):
        try:
            spec = json.loads(Path(path).read_text())
            failures = validate_spec(spec)
        except (FileNotFoundError, json.JSONDecodeError) as e:
            print(f"forge: {path}: {e}", file=sys.stderr)
            worst = max(worst, 2)
            continue
        if failures:
            print(json.dumps({"file": str(path), "valid": False, "failures": failures}))
            worst = max(worst, 2)
            continue
        slug = spec["slug"]
        out = REPO / "staging" / slug
        out.mkdir(parents=True, exist_ok=True)
        spec_arg = Path(path).resolve()
        extra = []
        if "members" in spec:
            # flatten set → ordinary spec; report/GLB keep the SET spec's sha
            # (the committed source of truth), not the derived flattened file's
            try:
                flat = flatten_set(spec)
            except ValueError as e:
                print(f"forge: {slug}: {e}", file=sys.stderr)
                worst = max(worst, 2)
                continue
            spec_arg = out / "flattened.json"
            spec_arg.write_text(json.dumps(flat, indent=2) + "\n")
            extra = ["--spec-sha",
                     hashlib.sha256(Path(path).resolve().read_bytes()).hexdigest()]
        cmd = [blender, "--factory-startup", "-b", "--python-exit-code", "3",
               "--python", str(REPO / "builder" / "builder.py"), "--",
               "--spec", str(spec_arg), "--out", str(out), "--repo", str(REPO)] + extra
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=BUILD_TIMEOUT_S)
        except subprocess.TimeoutExpired:
            print(f"forge: {slug}: build timed out after {BUILD_TIMEOUT_S}s", file=sys.stderr)
            worst = max(worst, 3)
            continue
        for line in proc.stdout.splitlines():
            if line.startswith("forge-builder:"):
                print(line)
        rc = proc.returncode
        if rc not in (0, 1):
            tail = "\n".join((proc.stderr or proc.stdout).splitlines()[-15:])
            print(f"forge: {slug}: builder failed (exit {rc})\n{tail}", file=sys.stderr)
            worst = max(worst, 3)
            continue
        if not (out / "report.json").is_file():
            print(f"forge: {slug}: no report.json produced", file=sys.stderr)
            worst = max(worst, 3)
            continue
        worst = max(worst, rc)
    return worst


def _find_spec(slug):
    # `harvested/` is NOT `specs/`. A spec is a build recipe validated against
    # forgeSpec v1 and rebuildable byte-identically; a harvest manifest records
    # where a sourced asset came from and what was done to it. Filing them
    # together broke `forge validate --all` (5 test groups), because a manifest
    # cannot satisfy a schema for something that was never built here.
    for d in ("specs", "examples", "harvested"):
        p = REPO / d / f"{slug}.json"
        if p.is_file():
            try:
                return json.loads(p.read_text())
            except json.JSONDecodeError:
                return None
    return None


