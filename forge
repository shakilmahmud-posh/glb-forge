def _fallback_shape(spec):
    for part in spec.get("parts", []):
        t = part.get("type")
        if t == "array":
            t = (part.get("of") or {}).get("type")
        if t in ("cylinder", "lathe"):
            return "cylinder"
    return "box"


def _first_color(spec):
    for mat in (spec.get("materials") or {}).values():
        if isinstance(mat, dict) and mat.get("color"):
            return mat["color"]
    return "#c8c0b4"


